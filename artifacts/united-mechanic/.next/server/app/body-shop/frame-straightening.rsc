edericksburg, VA"}],["$","meta","13",{"name":"twitter:description","content":"25+ years serving Fredericksburg, VA. Auto repair, collision body shop & dealership services. Call 540-418-6626."}],["$","meta","14",{"name":"twitter:image","content":"https://www.myrideserivcecenter.com/myride-social-banner.jpg"}]],"error":null,"digest":"$undefined"}
