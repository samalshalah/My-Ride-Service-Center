1b:T77f,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I know if my shocks or struts are bad?","acceptedAnswer":{"@type":"Answer","text":"Signs include excessive bouncing after hitting a bump, nose-diving when braking, body roll in corners, uneven tire wear, and a generally loose or floaty feeling while driving."}},{"@type":"Question","name":"What is an alignment and why do I need it?","acceptedAnswer":{"@type":"Answer","text":"Alignment adjusts your wheel angles to manufacturer specifications, ensuring even tire wear, straight-line tracking, and optimal handling. It's needed after suspension repairs, hitting a large pothole, or if your vehicle pulls to one side."}},{"@type":"Question","name":"How long do shocks and struts last?","acceptedAnswer":{"@type":"Answer","text":"Most shocks and struts last 50,000–100,000 miles under normal driving conditions. Rough roads, heavy loads, and aggressive driving shorten their lifespan."}},{"@type":"Question","name":"What causes a clunking sound when going over bumps?","acceptedAnswer":{"@type":"Answer","text":"Clunking over bumps is most commonly caused by worn sway bar end links, loose ball joints, or degraded strut mounts. These are typically inexpensive repairs when caught early."}},{"@type":"Question","name":"Can I replace just one strut or do I need to do both?","acceptedAnswer":{"@type":"Answer","text":"We strongly recommend replacing struts in pairs. A new strut on one side and a worn strut on the other creates uneven handling and can affect braking balance in emergency situations."}},{"@type":"Question","name":"Will suspension repairs fix my uneven tire wear?","acceptedAnswer":{"@type":"Answer","text":"Yes — if uneven wear is caused by alignment issues or worn suspension components, correcting those problems along with a fresh alignment will allow your tires to wear evenly going forward."}}]}11:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1b"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Suspension & Steering Repairs\",\"description\":\"Expert suspension and steering repair in Fredericksburg, VA. My Ride Service Center replaces shocks, struts, control arms, tie rods & performs 4-wheel alignment. Call 540-418-6626.\",\"provider\":{\"@type\":\"LocalBusiness\",\"name\":\"My Ride Service Center\",\"telephone\":\"+15404186626\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"2715 Lafayette Blvd\",\"addressLocality\":\"Fredericksburg\",\"addressRegion\":\"VA\",\"postalCode\":\"22408\"}},\"areaServed\":[{\"@type\":\"City\",\"name\":\"Fredericksburg\"},{\"@type\":\"City\",\"name\":\"Stafford\"},{\"@type\":\"City\",\"name\":\"Spotsylvania\"}],\"url\":\"https://www.myrideserivcecenter.com/auto-repair/suspension-steering\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.myrideserivcecenter.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Auto Repair\",\"item\":\"https://www.myrideserivcecenter.com/auto-repair\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Suspension & Steering Repairs\",\"item\":\"https://www.myrideserivcecenter.com/auto-repair/suspension-steering\"}]}"}}],"$L1c"]
